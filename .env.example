# .env.example — 실제 값은 .env 파일에 복사 후 입력 (절대 커밋 금지)

# Mapbox Static API 토큰 (--map mapbox 사용 시 필요)
# 발급: account.mapbox.com → Tokens → Create a token
MAPBOX_TOKEN=pk.eyJ1IjoiYWNjb3VudC1uYW1lIiwiYSI6IlhYWFhYWFgifQ.XXXXXXXXXXXXXXXXXXXXXX

# Stadia Maps API 키 (--map stadia-dark / stadia-light 사용 시 필요)
# 발급: client.stadiamaps.com → Manage Properties → API Keys
# STADIA_API_KEY=your_stadia_api_key_here

# Google Maps (Phase 3 이후 Geocoding용, 선택)
# GOOGLE_MAPS_API_KEY=AIzaSy...

# OpenAI DALL-E 3 (선택)
# OPENAI_API_KEY=sk-...
